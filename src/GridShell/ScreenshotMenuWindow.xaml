<Window x:Class="GridShell.ScreenshotMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Screenshot"
        Width="320" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>

        <Style x:Key="MenuItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#444" BorderThickness="1">
        <StackPanel Margin="12">
            <TextBlock Text="Screenshot" FontSize="14" FontWeight="Bold" Foreground="White"
                       Margin="4,4,4,10" />

            <Border x:Name="WindowItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="WindowItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe30c;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Window" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="SnippetItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="SnippetItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe3be;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Snippet" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="FullscreenItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="FullscreenItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe5d0;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Fullscreen" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
