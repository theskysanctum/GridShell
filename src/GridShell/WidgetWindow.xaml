<Window x:Class="GridShell.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="GridShell Widget"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DropShadowEffect x:Key="CardShadow" Color="Black" Opacity="0.35" BlurRadius="10"
                           ShadowDepth="2" Direction="270" />
    </Window.Resources>

    <Grid>
        <!-- Media: plain WPF Image/MediaElement, deliberately not WebView2 - confirmed via
             Microsoft's own open WebView2 feedback issue (MicrosoftEdge/WebView2Feedback#1004)
             that WebView2 always consumes clicks itself; there is no supported way to make it
             click-through or non-activating. Image/MediaElement have no native child window
             at all, so there's nothing for a click to land on but this window's own
             WS_EX_TRANSPARENT style. No card background - the image/video itself IS the
             content. -->
        <Image Source="{Binding ImageSource}" Stretch="Fill"
               Visibility="{Binding IsImageMedia, Converter={StaticResource BoolToVisibility}}" />
        <MediaElement x:Name="Video" Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      IsMuted="True" MediaEnded="Video_MediaEnded"
                      Visibility="{Binding IsVideoMedia, Converter={StaticResource BoolToVisibility}}" />

        <!-- Clock -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12" Effect="{StaticResource CardShadow}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsClockKind, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockTimeText}" FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ClockDateText}" FontSize="14" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- System Stats -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12" Effect="{StaticResource CardShadow}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsSystemStatsKind, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding RamText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Desktop Icons - the one kind that isn't click-through (see WidgetWindow.xaml.cs),
             so it can receive the double-click that launches an item. -->
        <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12" Effect="{StaticResource CardShadow}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsIconGridKind, Converter={StaticResource BoolToVisibility}}">
            <ListBox x:Name="IconList" ItemsSource="{Binding IconEntries}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="IconList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="72" Margin="4">
                            <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
