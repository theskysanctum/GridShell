<Window x:Class="GridShell.ControllerHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="GridShell"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
        <DropShadowEffect x:Key="CardShadow" Color="Black" Opacity="0.4" BlurRadius="16" ShadowDepth="3" Direction="270" />
    </Window.Resources>
    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="{DynamicResource AccentOutlineBrush}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" Padding="16,14">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xf135;" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl x:Name="DeviceNamesList" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="{DynamicResource AccentOutlineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />

            <TextBlock Text="Shortcuts (everywhere)" FontSize="11" FontWeight="Bold"
                       Foreground="#999" Margin="0,0,0,6" />

            <ItemsControl x:Name="BindingsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Button}" FontSize="12"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12"
                                       Foreground="White" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
