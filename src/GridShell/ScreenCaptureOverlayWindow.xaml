<Window x:Class="GridShell.ScreenCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="GridShell Screen Capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid>
        <!-- Dims everything so the still-bright selection rectangle reads clearly against it. -->
        <Border Background="Black" Opacity="0.35" />

        <TextBlock x:Name="HintText" Text="Drag to select an area to capture - Esc to cancel"
                   Foreground="White" FontSize="14" Margin="0,24,0,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top" />

        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRect" StrokeThickness="2" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
