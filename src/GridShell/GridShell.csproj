<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GridShell.Core\GridShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom SDL3 build (SDL_HIDAPI_LIBUSB=ON) replacing ppy.SDL3-CS's bundled binary, which
         lacks libusb and therefore cannot see wired Nintendo Switch 1/2 controllers over USB.
         See src/ThirdPartyNative/SDL3-libusb/README.txt. Copied after the package's own
         runtime-asset copy so it overwrites it, not the other way around. -->
    <None Include="..\ThirdPartyNative\SDL3-libusb\SDL3.dll" CopyToOutputDirectory="PreserveNewest" Link="SDL3.dll" />
    <None Include="..\ThirdPartyNative\SDL3-libusb\libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" Link="libusb-1.0.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Community-maintained SDL_GameControllerDB mappings (zlib-licensed), widening gamepad
         recognition beyond SDL's own built-in list. See GridShell.Core/Interop/PadReader.cs. -->
    <None Include="..\GridShell.Core\Interop\GameControllerDB\gamecontrollerdb.txt" CopyToOutputDirectory="PreserveNewest" Link="GameControllerDB\gamecontrollerdb.txt" />
    <None Include="..\GridShell.Core\Interop\GameControllerDB\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="GameControllerDB\LICENSE.txt" />
  </ItemGroup>

  <Target Name="OverrideSdl3WithLibusbBuild" AfterTargets="Build;Publish">
    <Copy SourceFiles="..\ThirdPartyNative\SDL3-libusb\SDL3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\ThirdPartyNative\SDL3-libusb\libusb-1.0.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <Resource Include="Fonts\Roboto.ttf" />
    <Resource Include="Fonts\MaterialSymbolsOutlined.ttf" />
    <Resource Include="Fonts\Exo2.ttf" />
    <Resource Include="Fonts\Rajdhani.ttf" />
    <Resource Include="Fonts\Orbitron.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <!-- Kept in sync with installer/GridShell.iss's MyAppVersion by the release workflow's
         version-bump step - this is what UpdateChecker reads via Assembly.GetName().Version to
         compare against the latest GitHub release. -->
    <Version>1.1.46</Version>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
