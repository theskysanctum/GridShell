<Window x:Class="GridShell.ScrapeCoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="Scrape Cover Art"
        Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Search for the right game, then pick its cover."
                   Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="QueryBox" Padding="4" Margin="0,0,8,0"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                     Background="{DynamicResource SurfaceBackgroundBrush}"
                     KeyDown="QueryBox_KeyDown" />
            <Button Grid.Column="1" Padding="10,6" Click="SearchButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="Searching..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="No matches - try a different search." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />
            <ListBox ItemsSource="{Binding Candidates}" Background="{DynamicResource SurfaceBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityInverse}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="64" Margin="0,0,10,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" />
                                <Button Grid.Column="2" Content="Use this" Padding="10,6" VerticalAlignment="Center"
                                        Click="SelectButton_Click" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="10,6" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
