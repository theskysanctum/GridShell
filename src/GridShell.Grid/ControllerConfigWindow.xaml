<Window x:Class="GridShell.ControllerConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="Configure Controller"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <local:ConfigCategoryDisplayNameConverter x:Key="CategoryName" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="90" />
        </Style>
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DeviceName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryItem}"
                     Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource CategoryName}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Remap -->
                    <StackPanel Visibility="{Binding IsRemapSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Button Remap" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding RemapRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SourceName}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TargetOptions}"
                                                  SelectedItem="{Binding SelectedTarget}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- LED -->
                    <StackPanel Visibility="{Binding IsLedSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LED Color (DualShock 4 / DualSense)" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Red" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LedRed}" />
                            <TextBlock Grid.Column="2" Text="{Binding LedRed}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Green" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LedGreen}" />
                            <TextBlock Grid.Column="2" Text="{Binding LedGreen}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Blue" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LedBlue}" />
                            <TextBlock Grid.Column="2" Text="{Binding LedBlue}" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="Apply LED Color" HorizontalAlignment="Left" Padding="10,4" Click="ApplyLed_Click" />
                    </StackPanel>

                    <!-- Rumble -->
                    <StackPanel Visibility="{Binding IsRumbleSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Rumble" Style="{StaticResource SectionHeader}" />
                        <Button Content="Test Rumble" HorizontalAlignment="Left" Padding="10,4" Click="TestRumble_Click" />
                    </StackPanel>

                    <!-- Gyro / Accel -->
                    <StackPanel Visibility="{Binding IsGyroAccelSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Gyro / Accelerometer" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="Enable gyro" IsChecked="{Binding GyroEnabled}" IsEnabled="{Binding HasGyro}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding GyroReadout}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,0,0,8" />
                        <CheckBox Content="Enable accelerometer" IsChecked="{Binding AccelEnabled}" IsEnabled="{Binding HasAccel}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AccelReadout}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" />
                        <TextBlock Text="Not supported on this controller." Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                   Visibility="{Binding NoSensorsVisibility}" />
                    </StackPanel>

                    <!-- Touchpad -->
                    <StackPanel Visibility="{Binding IsTouchpadSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Touchpad (DualShock 4 / DualSense)" Style="{StaticResource SectionHeader}" />
                        <StackPanel Visibility="{Binding HasTouchpadVisibility}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Click mode" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TouchpadClickModeOptions}" SelectedItem="{Binding TouchpadClickMode}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sensitivity" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="0.25" Maximum="3" Value="{Binding TouchpadSensitivity}" />
                                <TextBlock Grid.Column="2" Text="{Binding TouchpadSensitivity, StringFormat='{}{0:F1}x'}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding TouchpadReadout}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="Not supported on this controller." Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                   Visibility="{Binding NoTouchpadVisibility}" />
                    </StackPanel>

                    <!-- Adaptive Triggers -->
                    <StackPanel Visibility="{Binding IsAdaptiveTriggersSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Adaptive Triggers (DualSense, experimental)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-8,0,8"
                                   Text="Unofficial, reverse-engineered protocol - behavior isn't guaranteed and may need adjusting." />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Right trigger" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerModeOptions}" SelectedItem="{Binding RightTriggerMode}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Left trigger" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerModeOptions}" SelectedItem="{Binding LeftTriggerMode}" />
                        </Grid>
                        <Button Content="Apply Trigger Modes" HorizontalAlignment="Left" Padding="10,4" Click="ApplyTriggers_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Padding="12,6" Margin="0,0,8,0" Click="Save_Click" IsDefault="True" />
            <Button Content="Close" Padding="12,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
