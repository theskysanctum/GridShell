<Window x:Class="GridShell.FileExplorerActionsMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Actions"
        Width="280" Height="630"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <FontFamily x:Key="IconFont">../Fonts/#Material Symbols Outlined</FontFamily>

        <Style x:Key="MenuItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="{DynamicResource AccentOutlineBrush}" BorderThickness="1">
        <StackPanel Margin="12">
            <TextBlock Text="Actions" FontSize="14" FontWeight="Bold" Foreground="White"
                       Margin="4,4,4,10" />

            <Border x:Name="CopyItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="CopyItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe14d;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Copy" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="CutItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="CutItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe14e;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Cut" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="PasteItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="PasteItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe14f;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Paste" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="RenameItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="RenameItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe9a2;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rename" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="NewFolderItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="NewFolderItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe2cc;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="New Folder" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="DeleteItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="DeleteItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Delete" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="ExtractHereItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="ExtractHereItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe169;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Extract Here" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="ExtractToItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="ExtractToItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xeb2c;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Extract to..." FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="AddToZipItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="AddToZipItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe149;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add to .zip" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="AddTo7zItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="AddTo7zItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe149;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add to .7z" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="CompressToChdItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="CompressToChdItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe149;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Compress to .chd" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="ExtractXisoItem" Style="{StaticResource MenuItemStyle}"
                    MouseLeftButtonUp="ExtractXisoItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe169;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Extract Xbox ISO" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
