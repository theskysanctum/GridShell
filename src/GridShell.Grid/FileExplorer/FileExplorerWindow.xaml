<Window x:Class="GridShell.FileExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="GridShell Explorer"
        Width="1100" Height="650" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="IconFont">../Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One pane's whole UI (toolbar + list) - instantiated twice below, bound to a
             different FileExplorerPaneViewModel each time via DataContext. -->
        <DataTemplate x:Key="PaneTemplate">
            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- A thin accent-colored bar marks which pane the controller/keyboard is
                     currently driving - the only visual cue once mouse hover isn't the thing
                     indicating focus. -->
                <Border Grid.Row="0" Grid.RowSpan="2" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6">
                    <Button Padding="6,4" Margin="0,0,4,0" Click="BackButton_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanGoBack}">
                        <TextBlock Text="&#xe5c4;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                    <Button Padding="6,4" Margin="0,0,4,0" Click="ForwardButton_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanGoForward}">
                        <TextBlock Text="&#xe5c8;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                    <Button Padding="6,4" Margin="0,0,8,0" Click="UpButton_Click" Tag="{Binding}"
                            IsEnabled="{Binding CanGoUp}">
                        <TextBlock Text="&#xe5db;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                    <TextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ListView Grid.Row="1" x:Name="PaneListView" ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          Background="Transparent" BorderThickness="0"
                          Tag="{Binding}"
                          PreviewMouseDown="PaneListView_PreviewMouseDown"
                          MouseDoubleClick="PaneListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}" />
                            <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding DateDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding LeftPane}" ContentTemplate="{StaticResource PaneTemplate}" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource PanelBorderBrush}" />
            <ContentControl Grid.Column="2" Content="{Binding RightPane}" ContentTemplate="{StaticResource PaneTemplate}" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="D-pad/R-stick: move   •   Cross/A: open   •   Circle/B: up a folder (or close)   •   LB/RB: switch pane   •   Square/X, right-click, or Menu key: actions   •   Ctrl+C/X/V, Del, F2: copy/cut/paste, delete, rename   •   Esc: close" />
        </Border>
    </Grid>
</Window>
