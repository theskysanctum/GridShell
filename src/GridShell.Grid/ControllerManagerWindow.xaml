<Window x:Class="GridShell.ControllerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Controller Manager"
        Width="880" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                   Text="Turns a controller GridShell can already read (via SDL) but Windows' XInput can't into a virtual Xbox360 controller, so other apps and games can use it too. Hiding the original device needs ViGEmBus and HidHide installed." />

        <ListBox Grid.Row="1" x:Name="DeviceList" ItemsSource="{Binding Devices}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="{DynamicResource WindowBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                           Text="{Binding StatusText}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasTouchpad, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="Touchpad click mode"
                                      ItemsSource="{Binding TouchpadClickModeOptions}" SelectedItem="{Binding TouchpadClickMode}" />
                            <Button Grid.Column="2" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Content="Configure..." Click="ConfigureButton_Click" CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Content="{Binding VirtualPadButtonText}"
                                    Click="VirtualPadButton_Click" CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Padding="10,6" VerticalAlignment="Center"
                                    Content="{Binding HideButtonText}" IsEnabled="{Binding CanToggleHide}"
                                    Click="HideButton_Click" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="No controllers detected." VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Visibility="{Binding NoDevicesVisibility}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="12,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
