<Window x:Class="GridShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridShell"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="GridShell"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        KeyDown="Window_KeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <sys:Double x:Key="TileWidth">140</sys:Double>
        <sys:Double x:Key="TileHeight">110</sys:Double>
        <sys:Double x:Key="GameTileWidth">140</sys:Double>
        <sys:Double x:Key="GameTileHeight">196</sys:Double>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A soft ambient shadow under every tile/panel/button — the one thing that most makes
             a flat dark UI read as "bare": nothing is visually lifted off the background. -->
        <DropShadowEffect x:Key="CardShadow" Color="Black" Opacity="0.4" BlurRadius="16"
                           ShadowDepth="3" Direction="270" />

        <!-- Rounded, flat, hover-reactive — replaces WPF's default beveled ButtonChrome, which
             reads as dated next to the rest of GridShell's custom dark styling. Individual
             buttons below layer their own active-tab/pressed triggers on top via BasedOn. -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strips the default ListBoxItem selection chrome (a blocky filled rectangle plus a
             dashed focus rect) entirely — the tile templates below draw their own selection ring
             instead, so a selected/hovered tile gets a thin accent border rather than that. -->
        <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared by both tile templates — a thin accent ring on selection/hover, matching the
             tile's own corner radius, instead of a default WPF selection fill. -->
        <Style x:Key="TileSelectionBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared by both tile templates below, so Rename/Change Icon/Remove stay identical
             regardless of which layout a tile's kind picks. -->
        <ContextMenu x:Key="TileContextMenu">
            <MenuItem Header="Rename..." Click="RenameTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xf097;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Change Icon..." Click="ChangeIcon_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Remove" Click="RemoveTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Game tiles alone get IGDB cover art, and the automatic best-match pick can be
             wrong (common title, a remaster vs. the original, a region-specific release) - a
             separate menu (rather than one shared item with a Kind-based Visibility binding)
             keeps this out of Apps/Web tiles' menu entirely. -->
        <ContextMenu x:Key="GameTileContextMenu">
            <MenuItem Header="Rename..." Click="RenameTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xf097;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Change Icon..." Click="ChangeIcon_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Scrape Cover Art..." Click="ScrapeCoverMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Remove" Click="RemoveTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="RegularTileTemplate">
            <Border Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}"
                    Margin="8" CornerRadius="10"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    ContextMenu="{StaticResource TileContextMenu}"
                    Effect="{StaticResource CardShadow}"
                    Style="{StaticResource TileSelectionBorderStyle}">
                <StackPanel VerticalAlignment="Center" Margin="8">
                    <Image Source="{Binding Icon}"
                           Width="32" Height="32"
                           Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Box-art style: the cover fills the whole tile, with the name as a small label over
             a gradient at the bottom edge — matches how IGDB cover art (portrait, like a game
             box) reads best, unlike the small-icon-above-label layout the other kinds use. A
             game with no IGDB match yet (no credentials, offline, no result) still gets this
             layout with its .exe icon stretched to fill, rather than a different template
             flickering in once a cover loads. -->
        <DataTemplate x:Key="GameTileTemplate">
            <!-- A Border always rounds its own Background fill to its CornerRadius natively —
                 unlike ClipToBounds (which only clips to the rectangular bounding box, not the
                 rounded shape), this needs no clip-geometry tricks. Cover art is an ImageBrush
                 on its own full-size Border; the gradient+name overlay is a second Border with
                 just its bottom corners rounded, since it only touches the bottom edge. -->
            <Border Width="{DynamicResource GameTileWidth}" Height="{DynamicResource GameTileHeight}"
                    Margin="8" CornerRadius="10"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Effect="{StaticResource CardShadow}"
                    Style="{StaticResource TileSelectionBorderStyle}">
                <Grid>
                    <Border CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Bottom" Padding="8,20,8,8" CornerRadius="0,0,10,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#D0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <local:GameTileTemplateSelector x:Key="TileTemplateSelector"
                                         RegularTemplate="{StaticResource RegularTileTemplate}"
                                         GameTemplate="{StaticResource GameTileTemplate}" />

        <!-- Only grouped (by PlatformGroupName) while the Games tab is active - toggled in
             code (ApplyFilter) rather than always-on, since Apps/Web were never asked to group
             and a single "PC" header over every app/website tile would just be noise. -->
        <CollectionViewSource x:Key="GroupedTiles" Source="{Binding Tiles}" />
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <!-- The window itself is fully transparent (AllowsTransparency) so this panel alone
             controls the see-through amount — everything else (tiles, top bar, buttons) stays
             fully opaque since Opacity only affects this element, not its siblings. -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.82" />

        <ListBox x:Name="TileList"
                 ItemsSource="{Binding Source={StaticResource GroupedTiles}}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="24,72,24,24"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemTemplateSelector="{StaticResource TileTemplateSelector}"
                 ItemContainerStyle="{StaticResource TileContainerStyle}"
                 MouseDoubleClick="TileList_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       Margin="24,12,0,0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>

        <!-- A 3-column Grid (not independently-positioned Left/Center/Right panels) so the
             layout system itself keeps these from ever overlapping: the outer columns get
             exactly what their buttons need, and the search bar's center column only ever gets
             whatever's left — shrinking gracefully at narrow window widths instead of the
             search bar and the add-tile button fighting over the same space. -->
        <Grid Margin="24,16,24,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Apps" Padding="14,6" Margin="0,0,8,0" Click="AppsTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppsTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Web" Padding="14,6" Margin="0,0,8,0" Click="WebTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Games" Padding="14,6" Click="GamesTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGamesTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="GameManagerButton" Padding="8,6" Margin="8,0,0,0" Click="GameManagerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Game Manager"
                        Visibility="{Binding IsGamesTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xea28;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="16" />
                </Button>
                <Button x:Name="AddTileButton" Padding="8,6" Margin="8,0,0,0" Click="AddTileButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Add"
                        Visibility="{Binding IsWebTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xe145;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="16" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="10" Padding="14,8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <TextBlock Text="{Binding SearchDisplay}"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="8" Margin="0,0,8,0" Click="ExplorerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="File Explorer">
                    <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Margin="0,0,8,0" Click="StoreButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Store">
                    <TextBlock Text="&#xe8d1;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Margin="0,0,8,0" Click="DownloadManagerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Downloads">
                    <TextBlock Text="&#xf090;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Click="SettingsButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Settings">
                    <TextBlock Text="&#xe8b8;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,72,16">
            <Button Padding="8" Margin="0,0,8,0" Click="SteamButton_Click" Style="{StaticResource ModernButtonStyle}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Steam">
                <Viewbox Width="20" Height="20">
                    <Path Fill="White" Data="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z" />
                </Viewbox>
            </Button>
            <Button Padding="8" Margin="0,0,8,0" Click="EpicButton_Click" Style="{StaticResource ModernButtonStyle}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Epic Games">
                <Viewbox Width="20" Height="20">
                    <Path Fill="White" Data="M3.537 0C2.165 0 1.66.506 1.66 1.879V18.44a4.262 4.262 0 00.02.433c.031.3.037.59.316.92.027.033.311.245.311.245.153.075.258.13.43.2l8.335 3.491c.433.199.614.276.928.27h.002c.314.006.495-.071.928-.27l8.335-3.492c.172-.07.277-.124.43-.2 0 0 .284-.211.311-.243.28-.33.285-.621.316-.92a4.261 4.261 0 00.02-.434V1.879c0-1.373-.506-1.88-1.878-1.88zm13.366 3.11h.68c1.138 0 1.688.553 1.688 1.696v1.88h-1.374v-1.8c0-.369-.17-.54-.523-.54h-.235c-.367 0-.537.17-.537.539v5.81c0 .369.17.54.537.54h.262c.353 0 .523-.171.523-.54V8.619h1.373v2.143c0 1.144-.562 1.71-1.7 1.71h-.694c-1.138 0-1.7-.566-1.7-1.71V4.82c0-1.144.562-1.709 1.7-1.709zm-12.186.08h3.114v1.274H6.117v2.603h1.648v1.275H6.117v2.774h1.74v1.275h-3.14zm3.816 0h2.198c1.138 0 1.7.564 1.7 1.708v2.445c0 1.144-.562 1.71-1.7 1.71h-.799v3.338h-1.4zm4.53 0h1.4v9.201h-1.4zm-3.13 1.235v3.392h.575c.354 0 .523-.171.523-.54V4.965c0-.368-.17-.54-.523-.54zm-3.74 10.147a1.708 1.708 0 01.591.108 1.745 1.745 0 01.49.299l-.452.546a1.247 1.247 0 00-.308-.195.91.91 0 00-.363-.068.658.658 0 00-.28.06.703.703 0 00-.224.163.783.783 0 00-.151.243.799.799 0 00-.056.299v.008a.852.852 0 00.056.31.7.7 0 00.157.245.736.736 0 00.238.16.774.774 0 00.303.058.79.79 0 00.445-.116v-.339h-.548v-.565H7.37v1.255a2.019 2.019 0 01-.524.307 1.789 1.789 0 01-.683.123 1.642 1.642 0 01-.602-.107 1.46 1.46 0 01-.478-.3 1.371 1.371 0 01-.318-.455 1.438 1.438 0 01-.115-.58v-.008a1.426 1.426 0 01.113-.57 1.449 1.449 0 01.312-.46 1.418 1.418 0 01.474-.309 1.58 1.58 0 01.598-.111 1.708 1.708 0 01.045 0zm11.963.008a2.006 2.006 0 01.612.094 1.61 1.61 0 01.507.277l-.386.546a1.562 1.562 0 00-.39-.205 1.178 1.178 0 00-.388-.07.347.347 0 00-.208.052.154.154 0 00-.07.127v.008a.158.158 0 00.022.084.198.198 0 00.076.066.831.831 0 00.147.06c.062.02.14.04.236.061a3.389 3.389 0 01.43.122 1.292 1.292 0 01.328.17.678.678 0 01.207.24.739.739 0 01.071.337v.008a.865.865 0 01-.081.382.82.82 0 01-.229.285 1.032 1.032 0 01-.353.18 1.606 1.606 0 01-.46.061 2.16 2.16 0 01-.71-.116 1.718 1.718 0 01-.593-.346l.43-.514c.277.223.578.335.9.335a.457.457 0 00.236-.05.157.157 0 00.082-.142v-.008a.15.15 0 00-.02-.077.204.204 0 00-.073-.066.753.753 0 00-.143-.062 2.45 2.45 0 00-.233-.062 5.036 5.036 0 01-.413-.113 1.26 1.26 0 01-.331-.16.72.72 0 01-.222-.243.73.73 0 01-.082-.36v-.008a.863.863 0 01.074-.359.794.794 0 01.214-.283 1.007 1.007 0 01.34-.185 1.423 1.423 0 01.448-.066 2.006 2.006 0 01.025 0zm-9.358.025h.742l1.183 2.81h-.825l-.203-.499H8.623l-.198.498h-.81zm2.197.02h.814l.663 1.08.663-1.08h.814v2.79h-.766v-1.602l-.711 1.091h-.016l-.707-1.083v1.593h-.754zm3.469 0h2.235v.658h-1.473v.422h1.334v.61h-1.334v.442h1.493v.658h-2.255zm-5.3.897l-.315.793h.624zm-1.145 5.19h8.014l-4.09 1.348z" />
                </Viewbox>
            </Button>
            <Button Padding="8" Margin="0,0,8,0" Click="GogButton_Click" Style="{StaticResource ModernButtonStyle}"
