<Window x:Class="GridShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridShell"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:interop="clr-namespace:GridShell.Core.Interop;assembly=GridShell.Core"
        mc:Ignorable="d"
        interop:ScreenChangeReaction.ExcludeFromWorkAreaFit="True"
        Title="GridShell"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource AppFontFamily}"
        KeyDown="Window_KeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <sys:Double x:Key="TileWidth">140</sys:Double>
        <sys:Double x:Key="TileHeight">110</sys:Double>
        <sys:Double x:Key="GameTileWidth">140</sys:Double>
        <sys:Double x:Key="GameTileHeight">196</sys:Double>
        <sys:Double x:Key="GamesGridVisibleHeight">212</sys:Double>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A soft ambient shadow under every tile/panel/button — the one thing that most makes
             a flat dark UI read as "bare": nothing is visually lifted off the background. -->
        <DropShadowEffect x:Key="CardShadow" Color="Black" Opacity="0.4" BlurRadius="16"
                           ShadowDepth="3" Direction="270" />

        <!-- Rounded, flat, hover-reactive — replaces WPF's default beveled ButtonChrome, which
             reads as dated next to the rest of GridShell's custom dark styling. Individual
             buttons below layer their own active-tab/pressed triggers on top via BasedOn. -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strips the default ListBoxItem selection chrome (a blocky filled rectangle plus a
             dashed focus rect) entirely — the tile templates below draw their own selection ring
             instead, so a selected/hovered tile gets a thin accent border rather than that. -->
        <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared by both tile templates — a consistent, animated accent ring on selection. -->
        <Style x:Key="TileSelectionBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TileSelectionBorderBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="TileSelectionBorderAnimation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.RelativeTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:4"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(Brush.Opacity)"
                                                 From="0.35" To="1" Duration="0:0:1.2"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="TileSelectionBorderAnimation" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Website tiles alone get Rename/Change Icon/Remove here - App tiles have no
                     right-click menu at all. A GameTileTemplate Border's own local ContextMenu
                     attribute (GameTileContextMenu) always wins over this style setter, so Game
                     tiles are unaffected by this trigger despite sharing this same style. -->
                <DataTrigger Binding="{Binding IsWebsiteKind}" Value="True">
                    <Setter Property="ContextMenu" Value="{StaticResource TileContextMenu}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameTileSelectionBorderStyle" TargetType="Border"
               BasedOn="{StaticResource TileSelectionBorderStyle}" />

        <!-- Website tiles' own Rename/Change Icon/Remove menu - wired via TileSelectionBorderStyle's
             own IsWebsiteKind trigger above, not a local ContextMenu attribute, so App tiles
             (which share RegularTileTemplate) stay menu-less. -->
        <ContextMenu x:Key="TileContextMenu">
            <MenuItem Header="Rename..." Click="RenameTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xf097;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Change Icon..." Click="ChangeIcon_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Remove" Click="RemoveTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Game tiles alone get IGDB cover art, and the automatic best-match pick can be
             wrong (common title, a remaster vs. the original, a region-specific release) - a
             separate menu (rather than one shared item with a Kind-based Visibility binding)
             keeps this out of Apps/Web tiles' menu entirely. -->
        <ContextMenu x:Key="GameTileContextMenu">
            <MenuItem Header="Rename..." Click="RenameTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xf097;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Change Icon..." Click="ChangeIcon_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Scrape Cover Art..." Click="ScrapeCoverMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Remove" Click="RemoveTileMenuItem_Click"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="RegularTileTemplate">
            <Border Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}"
                    Margin="8" CornerRadius="10"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    Effect="{StaticResource CardShadow}"
                    Style="{StaticResource TileSelectionBorderStyle}">
                <StackPanel VerticalAlignment="Center" Margin="8">
                    <Image Source="{Binding Icon}"
                           Width="32" Height="32"
                           Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Box-art style: the cover fills the whole tile, with the name as a small label over
             a gradient at the bottom edge — matches how IGDB cover art (portrait, like a game
             box) reads best, unlike the small-icon-above-label layout the other kinds use. A
             game with no IGDB match yet (no credentials, offline, no result) still gets this
             layout with its .exe icon stretched to fill, rather than a different template
             flickering in once a cover loads. -->
        <DataTemplate x:Key="GameTileTemplate">
            <!-- A Border always rounds its own Background fill to its CornerRadius natively —
                 unlike ClipToBounds (which only clips to the rectangular bounding box, not the
                 rounded shape), this needs no clip-geometry tricks. Cover art is an ImageBrush
                 on its own full-size Border; the gradient+name overlay is a second Border with
                 just its bottom corners rounded, since it only touches the bottom edge. -->
            <Border Width="{DynamicResource GameTileWidth}" Height="{DynamicResource GameTileHeight}"
                    Margin="8" CornerRadius="10"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Effect="{StaticResource CardShadow}"
                    Style="{StaticResource GameTileSelectionBorderStyle}">
                <Grid>
                    <Border CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Bottom" Padding="8,20,8,8" CornerRadius="0,0,10,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#D0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <local:GameTileTemplateSelector x:Key="TileTemplateSelector"
                                         RegularTemplate="{StaticResource RegularTileTemplate}"
                                         GameTemplate="{StaticResource GameTileTemplate}" />
    </Window.Resources>
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <!-- Dim backdrop behind the centered panel below, spanning the whole work area - this
             is also the modal's light-dismiss target: Window_PreviewMouseDown closes the grid
             when a click lands directly on this Border (never on the panel or anything inside
             it). Overdrawn 1px past every edge so layout rounding never lands exactly on the
             real edge and exposes the window's true (non-alpha-blended) transparent backdrop
             as a hairline. -->
        <Border x:Name="ScrimBorder" Background="Black" Opacity="0" Margin="-1" />

        <!-- The actual grid nearly fills the screen. Its own background is a separate sibling
             Border at reduced opacity (same trick the old
             full-screen background used) so the translucency affects only that fill, never the
             fully-opaque tiles/buttons/etc. stacked on top of it. -->
        <Border x:Name="ModalPanel" Margin="32" CornerRadius="16"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Effect="{StaticResource CardShadow}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ModalPanelSlideTransform" />
            </Border.RenderTransform>
            <Grid>
                <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.94" CornerRadius="16" />

        <Grid x:Name="AppsWebPanel" Margin="{Binding MainContentMargin}"
              Visibility="{Binding IsAppsOrWebTabActive, Converter={StaticResource BoolToVisibility}}"
              PreviewKeyDown="AppsWebPanel_PreviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding DefaultSectionRowHeight}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Visibility="{Binding IsBrowserShortcutVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Default Apps" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="8,0,0,6" />
                <ListBox x:Name="BrowserShortcutList"
                         ItemsSource="{Binding BrowserShortcutTiles}"
                         Background="Transparent" BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource RegularTileTemplate}"
                         ItemContainerStyle="{StaticResource TileContainerStyle}"
                         MouseDoubleClick="TileList_MouseDoubleClick" />
            </StackPanel>

            <Grid Grid.Row="0"
                  Visibility="{Binding IsDefaultWebsiteSectionVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Default Websites" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="8,0,0,6" />
                <ListBox x:Name="DefaultWebsiteList" Grid.Row="1"
                         ItemsSource="{Binding DefaultWebsiteTiles}"
                         Background="Transparent" BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemTemplateSelector="{StaticResource TileTemplateSelector}"
                         ItemContainerStyle="{StaticResource TileContainerStyle}"
                         MouseDoubleClick="TileList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="8,4,8,12"
                    Background="{DynamicResource AccentOutlineBrush}"
                    Visibility="{Binding IsDefaultSectionVisible, Converter={StaticResource BoolToVisibility}}" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding UserTileSectionTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="8,0,0,6" />
                <ListBox x:Name="TileList" Grid.Row="1"
                         ItemsSource="{Binding Tiles}"
                         Background="Transparent" BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemTemplateSelector="{StaticResource TileTemplateSelector}"
                         ItemContainerStyle="{StaticResource TileContainerStyle}"
                         MouseDoubleClick="TileList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Games tab only: platforms on the left ("PC" pinned at top), box art in a responsive
             grid on the right - replaces the flat/grouped TileList above for this tab only. -->
        <Grid Visibility="{Binding IsGamesTabActive, Converter={StaticResource BoolToVisibility}}"
              Margin="{Binding MainContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PlatformPaneWidth}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="PlatformList" Grid.Column="0"
                     ItemsSource="{Binding Platforms}"
                     Background="Transparent" BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ClipToBounds="True"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                     SelectionChanged="PlatformList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- ClipBorder is the hard boundary nothing may render past - a name
                             too long to fit shows an ellipsis normally, or (only while its item
                             is selected) scrolls left-to-right in place instead, both still
                             confined to this same clipped width. -->
                        <Border x:Name="ClipBorder" ClipToBounds="True">
                            <TextBlock x:Name="PlatformNameText" Text="{Binding}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="MarqueeTransform" X="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="PlatformNameText" Property="TextTrimming" Value="None" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                            Padding="{TemplateBinding Padding}" ClipToBounds="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- The visible divider between the platform list and the games grid - nothing
                 from either side (long platform names, the box-art grid) is allowed to render
                 past it, see ClipToBounds above and on GamesGrid below. -->
            <Border Grid.Column="1" Width="1" Margin="16,0" Background="{DynamicResource PanelBorderBrush}" />

            <ListBox x:Name="GamesGrid" Grid.Column="2"
                     ItemsSource="{Binding GamesForSelectedPlatform}"
                     Background="Transparent" BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ClipToBounds="True"
                     VerticalAlignment="Top"
                     MaxHeight="{DynamicResource GamesGridVisibleHeight}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ItemTemplate="{StaticResource GameTileTemplate}"
                     ItemContainerStyle="{StaticResource TileContainerStyle}"
                     SizeChanged="GamesGrid_SizeChanged"
                     MouseDoubleClick="TileList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GameGridColumns}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

        <Grid x:Name="HeaderPanel" Margin="24,16,24,0" VerticalAlignment="Top"
              SizeChanged="HeaderPanel_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Content="Apps" Padding="14,6" Margin="0,0,8,0" Click="AppsTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppsTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Web" Padding="14,6" Margin="0,0,8,0" Click="WebTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Games" Padding="14,6" Click="GamesTab_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGamesTabActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="GameManagerButton" Padding="8,6" Margin="8,0,0,0" Click="GameManagerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Game Manager"
                        Visibility="{Binding IsGamesTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xea28;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="16" />
                </Button>
                <Button x:Name="AddTileButton" Padding="8,6" Margin="8,0,0,0" Click="AddTileButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Add"
                        Visibility="{Binding IsWebTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xe145;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="16" />
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Padding="8" Margin="0,0,8,0" Click="ExplorerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="File Explorer">
                    <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Margin="0,0,8,0" Click="StoreButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Store">
                    <TextBlock Text="&#xe8d1;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Margin="0,0,8,0" Click="DownloadManagerButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Downloads">
                    <TextBlock Text="&#xf090;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
                <Button Padding="8" Click="SettingsButton_Click" Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Settings">
                    <TextBlock Text="&#xe8b8;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding AreLauncherShortcutsVisible, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,72,16">
            <Button Padding="8" Margin="0,0,8,0" Click="SteamButton_Click" Style="{StaticResource ModernButtonStyle}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderThickness="0" ToolTip="Steam">
                <Viewbox Width="20" Height="20">
