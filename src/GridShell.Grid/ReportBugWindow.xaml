<Window x:Class="GridShell.ReportBugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Report a Bug"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <StackPanel Margin="16">
        <TextBlock Text="What happened?" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="This opens a pre-filled GitHub issue - nothing is sent until you click Submit there."
                   Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

        <TextBox x:Name="DescriptionBox" Height="110" Padding="6" Margin="0,0,0,12"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                 Background="{DynamicResource SurfaceBackgroundBrush}" />

        <CheckBox x:Name="IncludeLogCheckBox" Content="Include the recent error log" IsChecked="True" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Open GitHub Issue" Padding="12,6" Click="OpenIssueButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
