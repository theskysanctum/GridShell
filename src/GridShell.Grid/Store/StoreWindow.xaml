<Window x:Class="GridShell.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="GridShell Store"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="IconFont">../Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <DropShadowEffect x:Key="CardShadow" Color="Black" Opacity="0.4" BlurRadius="16" ShadowDepth="3" Direction="270" />

        <!-- Shows the Tag text as a placeholder while the box is empty - the previous version
             set Tag="Search apps..." but nothing ever rendered it, since a plain TextBox has no
             built-in placeholder support. -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One flat list, filtered by SelectedCategory/search text in code - the left-hand
             category rail replaces the old inline group headers, matching this app's other
             two-pane config windows (Settings, Controller Manager) instead of a single long
             grouped list. -->
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <!-- The Games/Scenes-vs-catalog divider (CategorySeparatorLabel) is never a real
                     selectable category - disabling hit-testing/focus means IsMouseOver/
                     IsSelected above can never fire for it either. -->
                <DataTrigger Binding="{Binding}" Value="###CATEGORY_SEPARATOR###">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="14,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstallButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="16"
                                Padding="14,7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded capsule status badges - accent for Installed, the app's existing themed
             error color for Failed, muted/transparent while checking or installing. -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,16,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + search, search icon prefixed inside the field itself. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Store" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                <TextBlock Text="{Binding CatalogStatusText}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1" MaxWidth="360" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="18" Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBox Grid.Column="1" x:Name="SearchBox" Padding="0,9" VerticalContentAlignment="Center"
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                             Tag="Search apps..."
                             TextChanged="SearchBox_TextChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- Two-pane body: category rail on the left, app cards on the right. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock x:Name="CategoryLabel" Text="{Binding}" />
                            <Border x:Name="SeparatorLine" Visibility="Collapsed" Height="1"
                                    Margin="0,10,0,10" Background="{DynamicResource PanelBorderBrush}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="###CATEGORY_SEPARATOR###">
                                <Setter TargetName="CategoryLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SeparatorLine" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsAppsCategory, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="14" Margin="0,0,0,10"
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0">
                                        <Border CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityInverse}}">
                                            <TextBlock Text="{Binding InitialLetter}" FontSize="17" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="10" Background="{DynamicResource WindowBackgroundBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="7" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,12,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   MaxWidth="160" TextWrapping="Wrap" TextAlignment="Right"
                                                   Foreground="{DynamicResource ErrorForegroundBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource InstallButtonStyle}"
                                                Click="InstallButton_Click" CommandParameter="{Binding}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xf090;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Margin="0,0,4,0" Foreground="White" />
                                                <TextBlock Text="Install" FontSize="12" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InstallButtonStyle}"
                                                Click="UninstallButton_Click" CommandParameter="{Binding}"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Margin="0,0,4,0" Foreground="White" />
                                                <TextBlock Text="Uninstall" FontSize="12" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Scenes: animated wallpapers, not StoreApps - a thumbnail/Download card grid. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsScenesCategory, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Width="260" Margin="0,0,12,12"
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <Grid Height="146">
                                        <Border Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityInverse}}">
                                            <TextBlock Text="{Binding InitialLetter}" FontSize="28" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,10" />
                                        <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xf0be;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Margin="0,0,4,0" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="Downloaded" FontSize="11.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Style="{StaticResource InstallButtonStyle}" HorizontalAlignment="Left"
                                                Click="DownloadSceneButton_Click" CommandParameter="{Binding}"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityInverse}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xf090;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Margin="0,0,4,0" Foreground="White" />
                                                <TextBlock Text="{Binding DownloadButtonText}" FontSize="12" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Games are shown as a plain, scrollable list. Cover art is deliberately omitted;
                 double-click a row to choose a ROM folder and queue its download. -->
            <Grid Grid.Column="2" Visibility="{Binding IsGamesCategory, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="GamePlatformList" Grid.Column="0" ItemsSource="{Binding GamePlatforms}"
                         SelectedItem="{Binding SelectedGamePlatform}"
                         ItemContainerStyle="{StaticResource CategoryItemStyle}"
                         Background="Transparent" BorderThickness="0" ClipToBounds="True"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="GamePlatformList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ClipBorder" ClipToBounds="True">
                                <TextBlock x:Name="PlatformNameText" Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeTransform" X="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="PlatformNameText" Property="TextTrimming" Value="None" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource PanelBorderBrush}" />

                <Grid Grid.Column="2">
                    <TextBlock Text="{Binding GamesRepoStatusText}" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Visibility="{Binding HasGamesRepoStatusText, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer x:Name="GameLinkEntriesScrollViewer" VerticalAlignment="Top"
                                  ClipToBounds="True"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GameLinkEntries}" MouseDoubleClick="GameLinkEntry_MouseDoubleClick">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource MutedForegroundBrush}">
                                                    <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding MirrorCountDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                                    Padding="8,4" VerticalAlignment="Top"
                                                    Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Queued" FontSize="10" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,10"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="Esc: close" />
        </Border>
    </Grid>
</Window>
