<Window x:Class="GridShell.ChooseRomFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Choose ROM Folder"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Prompt}" Margin="0,0,0,12" TextWrapping="Wrap" />

        <ListBox x:Name="FolderListBox" ItemsSource="{Binding Options}" SelectedIndex="0"
                 DisplayMemberPath="Label" Margin="0,0,0,12" MaxHeight="220"
                 MouseDoubleClick="FolderListBox_MouseDoubleClick" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Download" Padding="12,6" Click="DownloadButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
