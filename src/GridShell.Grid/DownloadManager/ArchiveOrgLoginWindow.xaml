<Window x:Class="GridShell.ArchiveOrgLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Archive.org login"
        Width="1200" Height="820"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Sign in to Archive.org" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
            <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                       TextWrapping="Wrap"
                       Text="Sign in normally in this window, then click Use this session to pull the active Archive.org cookies into GridShell. This only captures cookies for archive.org and does not share them with other domains." />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
            <wv2:WebView2 x:Name="WebView" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Use this session" Padding="12,6" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Click="UseSessionButton_Click" />
            <Button Content="Cancel" Padding="12,6" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
