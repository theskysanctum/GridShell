<Window x:Class="GridShell.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="GridShell Downloads"
        Width="900" Height="600" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="IconFont">../Fonts/#Material Symbols Outlined</FontFamily>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Add bar -->
        <Grid Grid.Row="0" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkInputBox" Grid.Column="0" Padding="6" Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     ToolTip="A hoster link or a magnet link"
                     KeyDown="LinkInputBox_KeyDown" />
            <Button Grid.Column="1" Padding="12,6" Click="AddButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xe145;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                    <TextBlock Text="Add" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Real-Debrid status -->
        <TextBlock Grid.Row="1" Margin="12,0,12,8" FontSize="11"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Text="{Binding RealDebridStatusText}" />

        <!-- Queue -->
        <ListView Grid.Row="2" x:Name="DownloadsListView" Margin="12,0,12,8"
                  ItemsSource="{Binding Downloads}" SelectedItem="{Binding SelectedDownload}"
                  Background="Transparent" BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="290" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Status" Width="160" DisplayMemberBinding="{Binding StatusDisplay}" />
                    <GridViewColumn Header="Size" Width="150" DisplayMemberBinding="{Binding SizeDisplay}" />
                    <GridViewColumn Header="Speed" Width="90" DisplayMemberBinding="{Binding SpeedDisplay}" />
                    <GridViewColumn Header="Progress" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Width="120" Height="14" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource AccentBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="D-pad/R-stick: select   •   Cross/A: open containing folder   •   Square/X: cancel/remove   •   Esc: close" />
        </Border>
    </Grid>
</Window>
