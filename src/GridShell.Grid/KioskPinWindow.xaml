<Window x:Class="GridShell.KioskPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Kiosk Mode PIN"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Prompt}" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- Set mode: choose a new PIN -->
        <StackPanel Visibility="{Binding IsSetMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="PIN" Margin="0,0,0,4" />
            <PasswordBox x:Name="PinBox" Padding="4" Margin="0,0,0,12" />

            <TextBlock Text="Confirm PIN" Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPinBox" Padding="4" Margin="0,0,0,12" />
        </StackPanel>

        <!-- Verify mode: enter the existing PIN -->
        <StackPanel Visibility="{Binding IsVerifyMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="PIN" Margin="0,0,0,4" />
            <PasswordBox x:Name="VerifyPinBox" Padding="4" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorForegroundBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Padding="12,6" Click="OkButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
