<Window x:Class="GridShell.AddTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Add Tile"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />

        <!-- One fixed set of fields per kind, picked by which "+" the user actually clicked —
             never a switchable tab strip, so there's no way to fill in one kind's fields and
             submit under a different one. -->
        <Grid Grid.Row="1">
            <Grid Margin="0,12,0,0" Visibility="{Binding IsAppKind, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" Padding="4" />

                <TextBlock Grid.Row="1" Text="Loading installed apps..."
                           Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredApps}"
                         SelectedItem="{Binding SelectedApp}"
                         DisplayMemberPath="Name"
                         Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                         MouseDoubleClick="AppList_MouseDoubleClick" />

                <Button Grid.Row="2" Content="Add App" Margin="0,8,0,0" Padding="8,4"
                        HorizontalAlignment="Left" Click="AddApp_Click" />

                <TextBlock Grid.Row="3" Text="Not in the list? Add it manually:"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,16,0,8" />

                <StackPanel Grid.Row="4" Margin="0,0,0,8">
                    <TextBlock Text="Title" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ManualAppTitle, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,8">
                    <TextBlock Text="Path" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ManualAppPath, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,4"
                                Click="BrowseManualAppPath_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                <TextBlock Text="Browse..." />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <Button Grid.Row="6" Content="Add Manually" Padding="8,4"
                        HorizontalAlignment="Left" Click="AddManualApp_Click" />
            </Grid>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWebsiteKind, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Title (optional)" Margin="0,0,0,4" />
                <TextBox Text="{Binding WebsiteName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,12" />

                <TextBlock Text="URL" Margin="0,0,0,4" />
                <TextBox Text="{Binding WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,12" />

                <TextBlock Text="Browser" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser}"
                          DisplayMemberPath="Name" Margin="0,0,0,12" />

                <TextBlock Text="No Chromium browser (Edge/Chrome/Brave) was found."
                           Foreground="{DynamicResource ErrorForegroundBrush}"
                           Visibility="{Binding NoBrowsersFound, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <Button Content="Add Website" Padding="8,4" HorizontalAlignment="Left"
                        Click="AddWebsite_Click" />
            </StackPanel>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsGameKind, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Title" Margin="0,0,0,4" />
                <TextBox Text="{Binding GameTitle, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,12" />

                <TextBlock Text="Path" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,4"
                            Click="BrowseGamePath_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Text="Browse..." />
                        </StackPanel>
                    </Button>
                </Grid>

                <CheckBox Content="Pause wallpaper while this is running"
                          IsChecked="{Binding PauseWallpaperWhileRunning}" Margin="0,0,0,12" />

                <Button Content="Add Game" Padding="8,4" HorizontalAlignment="Left"
                        Click="AddGame_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
