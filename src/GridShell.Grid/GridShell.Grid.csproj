<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GridShell.Grid</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <Version>1.1.96</Version>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GridShell.Core\GridShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ThirdPartyNative\SDL3-libusb\SDL3.dll" CopyToOutputDirectory="PreserveNewest" Link="SDL3.dll" />
    <None Include="..\ThirdPartyNative\SDL3-libusb\libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" Link="libusb-1.0.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GridShell.Core\Interop\GameControllerDB\gamecontrollerdb.txt" CopyToOutputDirectory="PreserveNewest" Link="GameControllerDB\gamecontrollerdb.txt" />
    <None Include="..\GridShell.Core\Interop\GameControllerDB\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="GameControllerDB\LICENSE.txt" />
  </ItemGroup>

  <Target Name="OverrideSdl3WithLibusbBuild" AfterTargets="Build;Publish">
    <Copy SourceFiles="..\ThirdPartyNative\SDL3-libusb\SDL3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\ThirdPartyNative\SDL3-libusb\libusb-1.0.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <Resource Include="..\GridShell\Fonts\Roboto.ttf" Link="Fonts\Roboto.ttf" />
    <Resource Include="..\GridShell\Fonts\MaterialSymbolsOutlined.ttf" Link="Fonts\MaterialSymbolsOutlined.ttf" />
    <Resource Include="..\GridShell\Fonts\Exo2.ttf" Link="Fonts\Exo2.ttf" />
    <Resource Include="..\GridShell\Fonts\Rajdhani.ttf" Link="Fonts\Rajdhani.ttf" />
    <Resource Include="..\GridShell\Fonts\Orbitron.ttf" Link="Fonts\Orbitron.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Tools\chdman.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\extract-xiso.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\extract-xiso.LICENSE.TXT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\aria2c.COPYING.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\aria2c.LICENSE.OpenSSL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\7za.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\7za.LICENSE.TXT" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ChromeExtension\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ChromeExtension\background.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
