<Window x:Class="GridShell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GridShell"
        mc:Ignorable="d"
        Title="Settings"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">./Fonts/#Material Symbols Outlined</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:CountToVisibilityInverseConverter x:Key="CountToVisibilityInverse" />

        <CollectionViewSource x:Key="GroupedEmulatorPlatforms" Source="{Binding EmulatorPlatforms}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Category "drop" header — a toggle-able row with a rotating chevron, driving the
             Expander below it. Collapsed by default so the (now 187-entry) platform list doesn't
             open as one long scroll. -->
        <Style x:Key="CategoryExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBackgroundBrush}"
                                CornerRadius="6" Padding="8,6" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron" Grid.Column="0" Text="&#xe5cc;" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WidgetRowTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SummaryText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                <Button Grid.Column="1" Width="28" Margin="4,0,0,0"
                        Click="RemoveWidgetButton_Click" CommandParameter="{Binding}" ToolTip="Remove">
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileRowTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Width="28" Margin="4,0,0,0"
                        Click="RemoveTileButton_Click" CommandParameter="{Binding}" ToolTip="Remove">
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Same as TileRowTemplate, plus a Scrape button - game tiles alone get IGDB cover art,
             and IgdbCoverService's automatic best-match pick can be wrong (common title, a
             remaster vs. the original, a region-specific release), so this lets the user search
             and choose the actual right cover. -->
        <DataTemplate x:Key="GameTileRowTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Padding="8,4" Margin="4,0,0,0"
                        Click="ScrapeButton_Click" CommandParameter="{Binding}" ToolTip="Search IGDB and pick the right cover">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                        <TextBlock Text="Scrape" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Width="28" Margin="4,0,0,0"
                        Click="RemoveTileButton_Click" CommandParameter="{Binding}" ToolTip="Remove">
                    <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <TabControl Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0">
            <TabItem Header="App Behavior">
                <StackPanel Margin="0,12,0,0">
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding AutostartEnabled}"
                              Margin="0,0,0,16" />

                    <TextBlock Text="Default browser for new website tiles" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedDefaultBrowser}"
                              DisplayMemberPath="Name" Margin="0,0,0,16" />

                    <CheckBox Content="Enable Win-key toggle (tap Win to show/hide GridShell)"
                              IsChecked="{Binding WinKeyHookEnabled}" />

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,16" />

                    <CheckBox Content="Use GridShell as the Windows shell (replaces Explorer)"
                              IsChecked="{Binding UseGridShellAsSystemShell}"
                              Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Machine-wide: affects every account on this PC and Safe Mode, not just yours. Takes effect on your next login, not immediately, and needs an admin (UAC) prompt. If something goes wrong: Ctrl+Shift+Esc, then File → Run new task → explorer.exe restores a normal desktop right away." />

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <Button Content="{Binding KioskModeButtonText}" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,4"
                            Click="KioskModeButton_Click" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Locks widgets, tiles, and wallpaper/appearance, and blocks the power menu and exiting GridShell. A PIN you set now is required to turn it back off." />

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <Button Content="Exit GridShell" Padding="10,6" HorizontalAlignment="Left"
                            Click="ExitGridShell_Click" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Tiles">
                <TabControl Margin="0,12,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}" BorderThickness="0"
                            IsEnabled="{Binding CanEditTiles}">
                    <TabItem Header="Apps">
                        <ListBox ItemsSource="{Binding AppTiles}" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 ItemTemplate="{StaticResource TileRowTemplate}" />
                    </TabItem>
                    <TabItem Header="Web">
                        <ListBox ItemsSource="{Binding WebTiles}" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 ItemTemplate="{StaticResource TileRowTemplate}" />
                    </TabItem>
                    <TabItem Header="Games">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="IGDB cover art" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Used to fetch box art for game tiles instead of the .exe icon. Needs a free Twitch developer app (dev.twitch.tv) with IGDB access."
                                           Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Client ID" Margin="0,0,0,4" />
                                <TextBox Text="{Binding IgdbClientId, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"
                                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                                         Background="{DynamicResource SurfaceBackgroundBrush}" />

                                <TextBlock Text="Client Secret" Margin="0,0,0,4" />
                                <PasswordBox x:Name="IgdbClientSecretBox" Padding="4" Margin="0,0,0,8"
                                             PasswordChanged="IgdbClientSecretBox_PasswordChanged" />

                                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                                <TextBlock Text="Installed games" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Adds a tile for every game already installed via Steam, Epic Games, or GOG Galaxy. itch.io isn't supported - its own integration guidelines require talking to a background daemon rather than reading its files directly."
                                           Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Padding="12,4" Click="ScanInstalledGamesButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                            <TextBlock Text="Scan for installed games" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledGameScanStatus}" FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding GameTiles}" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     ItemTemplate="{StaticResource GameTileRowTemplate}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Widgets">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               Text="Widgets need the wallpaper set to a local image or video file (Appearance tab) - the default Windows wallpaper or an HTML/live wallpaper don't qualify." />
                    <Grid Grid.Row="1" IsEnabled="{Binding CanEditWidgets}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox Grid.Row="0" ItemsSource="{Binding Widgets}"
                                 Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 ItemTemplate="{StaticResource WidgetRowTemplate}" />
                        <Button Grid.Row="1" Content="Add Widget" Padding="10,6" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="AddWidgetButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Appearance">
                <StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanEditAppearance}">
                    <TextBlock Text="Theme" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Margin="0,0,0,16">
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                    </ComboBox>

                    <TextBlock Text="Tile size" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding TileSize}" SelectedValuePath="Tag" Margin="0,0,0,16">
                        <ComboBoxItem Content="Small" Tag="Small" />
                        <ComboBoxItem Content="Medium" Tag="Medium" />
                        <ComboBoxItem Content="Large" Tag="Large" />
                    </ComboBox>

                    <TextBlock Text="Accent color" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding AccentSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32" Margin="0,0,8,0">
                                    <Button Background="{Binding Brush}"
                                            Click="AccentSwatch_Click" Tag="{Binding}"
                                            ToolTip="{Binding Hex}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <!-- A thicker, brighter ring makes the active color obvious at a
                                                         glance, on top of the checkmark overlay below. -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="&#xe668;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- The trailing "custom" square: a pencil hint when nothing custom is active
                                         yet (so it reads as "click to pick a color" rather than an empty swatch). -->
                                    <TextBlock Text="&#xf097;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCustom}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Font" Margin="0,16,0,4" />
                    <ComboBox SelectedValue="{Binding UiFont}" SelectedValuePath="Tag" Margin="0,0,0,8">
                        <ComboBoxItem Content="Roboto" Tag="Default" />
                        <ComboBoxItem Content="Exo 2" Tag="Gaming" />
                        <ComboBoxItem Content="Rajdhani" Tag="Rajdhani" />
                        <ComboBoxItem Content="Orbitron" Tag="Orbitron" />
                        <ComboBoxItem Content="Custom..." Tag="Custom" />
                    </ComboBox>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding CustomFontPath, TargetNullValue='No font picked yet - any missing characters fall back to the default.'}" />
                        <Button Grid.Column="1" Padding="8,4" Margin="8,0,0,0" Click="BrowseCustomFontButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                <TextBlock Text="Browse..." FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="Start button icon" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding StartIconOptions}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="36" Height="36" Margin="0,0,8,0" Click="StartIcon_Click" Tag="{Binding}"
                                        ToolTip="{Binding Name}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                               Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding StartButtonIconImagePath, TargetNullValue='No custom image - pick one above, or browse for your own.'}" />
                        <Button Grid.Column="1" Padding="8,4" Margin="8,0,0,0" Click="BrowseStartIconButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                <TextBlock Text="Browse..." FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Padding="8,4" Margin="8,0,0,0" Click="ClearStartIconImageButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartButtonIconImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                    </Grid>

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,16" />

                    <TextBlock Text="Wallpaper" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="A local image, video, or .html file, or a web URL, to render as the desktop background. Leave blank to just show your current Windows wallpaper image." />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WallpaperUrl, UpdateSourceTrigger=LostFocus}" Padding="4"
                                 Margin="0,0,8,0"
                                 ToolTip="e.g. C:\Wallpapers\sunset.mp4 or https://example.com/wallpaper" />
                        <Button Grid.Column="1" Padding="8,4" Click="BrowseWallpaperButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                <TextBlock Text="Browse..." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <CheckBox Content="Mute wallpaper audio" IsChecked="{Binding WallpaperMuted}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Downloads">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Real-Debrid" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Unrestricts hoster links and resolves magnet/torrent links in the Download Manager. Get a private API token from real-debrid.com/apitoken (requires a Premium account for most of it). Optional - without one, pasted links just download directly." />

                    <TextBlock Text="API token" Margin="0,0,0,4" />
                    <PasswordBox x:Name="RealDebridApiTokenBox" Padding="4" Margin="0,0,0,8"
                                 PasswordChanged="RealDebridApiTokenBox_PasswordChanged" />

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,16" />

                    <TextBlock Text="Download folder" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding DownloadManagerFolder, TargetNullValue='Your Windows Downloads folder (default)'}" />
                        <Button Grid.Column="1" Padding="8,4" Margin="8,0,0,0" Click="BrowseDownloadFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                <TextBlock Text="Browse..." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <TextBlock Text="Browser integration" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="A small Chrome/Chromium extension that routes every browser download to the Download Manager instead of Chrome's own download popup. Not on the Web Store - load it unpacked: open chrome://extensions, turn on Developer mode, click 'Load unpacked', and pick the folder this opens." />
                    <Button HorizontalAlignment="Left" Padding="8,4" Click="OpenExtensionFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Text="Open extension folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>

            <TabItem Header="Audio">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Output" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Device" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                              DisplayMemberPath="Name" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding OutputVolume}"
                                VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding OutputVolume, StringFormat='{}{0:F0}%'}"
                                   Width="38" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Grid.Column="2" Content="Mute" IsChecked="{Binding OutputMuted}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <TextBlock Text="Input" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Device" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                              DisplayMemberPath="Name" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding InputVolume}"
                                VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding InputVolume, StringFormat='{}{0:F0}%'}"
                                   Width="38" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Grid.Column="2" Content="Mute" IsChecked="{Binding InputMuted}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Bluetooth">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Content="Bluetooth" IsChecked="{Binding BluetoothRadioOn}" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Paired devices" FontWeight="Bold" Margin="0,0,0,8" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding PairedBluetoothDevices}"
                             Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                             Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Connected" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="2" Width="28"
                                            Click="UnpairBluetoothButton_Click" CommandParameter="{Binding}" ToolTip="Unpair">
                                        <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <Button Grid.Row="4" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="ScanBluetoothButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Scan for devices" Visibility="{Binding IsScanningBluetooth, Converter={StaticResource BoolToVisibilityInverse}}" />
                            <TextBlock Text="Stop scanning" Visibility="{Binding IsScanningBluetooth, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <ListBox Grid.Row="5" ItemsSource="{Binding DiscoveredBluetoothDevices}"
                             Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Pair" Padding="8,2"
                                            Click="PairBluetoothButton_Click" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Wi-Fi">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Content="Wi-Fi" IsChecked="{Binding WiFiRadioOn}" Margin="0,0,0,12" />

                    <Button Grid.Row="1" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="ScanWiFiButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xef7a;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Scan for networks" Visibility="{Binding IsScanningWiFi, Converter={StaticResource BoolToVisibilityInverse}}" />
                            <TextBlock Text="Scanning..." Visibility="{Binding IsScanningWiFi, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <ListBox Grid.Row="2" ItemsSource="{Binding WiFiNetworks}"
                             Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xe63e;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Ssid}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="&#xe899;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Visibility="{Binding IsSecured, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="3" Padding="8,2"
                                            Click="ConnectWiFiButton_Click" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="Connected" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="Connect" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityInverse}}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Display">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Monitor" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                              DisplayMemberPath="FriendlyName" Margin="0,0,0,16" />

                    <Button Content="Set as primary display" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,16"
                            Click="SetPrimaryButton_Click" IsEnabled="{Binding CanSetPrimary}" />

                    <TextBlock Text="Resolution" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution}"
                                  Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Apply" Padding="10,6" Click="ApplyResolutionButton_Click" />
                    </Grid>

                    <TextBlock Text="Brightness" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding BrightnessValue}"
                                VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding BrightnessSupported}" />
                        <TextBlock Grid.Column="1" Text="{Binding BrightnessValue, StringFormat='{}{0:F0}%'}"
                                   Width="38" VerticalAlignment="Center"
                                   Visibility="{Binding BrightnessSupported, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="Not supported on this display"
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding BrightnessSupported, Converter={StaticResource BoolToVisibilityInverse}}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Emulation">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Point each platform at an emulator you already have installed (ROMs are scanned from C:\Games\ROMs\&lt;platform&gt;, plus any extra folders below)."
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="RetroAchievements" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Log in once here - applied automatically to every RetroArch, Dolphin, and PCSX2 you've configured below." />

                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                                   Visibility="{Binding RetroAchievementsStatusVisible, Converter={StaticResource BoolToVisibility}}"
                                   Text="{Binding RetroAchievementsStatus}" Margin="0,0,0,8" />

                        <Grid Visibility="{Binding RetroAchievementsLoggedIn, Converter={StaticResource BoolToVisibilityInverse}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="RaUsernameBox" Padding="4" Margin="0,0,8,0"
                                     Text="{Binding RetroAchievementsUsernameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Username" />
                            <PasswordBox Grid.Column="1" x:Name="RaPasswordBox" Padding="4" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Padding="12,4" Click="RetroAchievementsLoginButton_Click">
                                <TextBlock Text="Log In" />
                            </Button>
                        </Grid>

                        <Grid Visibility="{Binding RetroAchievementsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{Binding RetroAchievementsUsername, StringFormat='Logged in as {0}'}" />
                            <Button Grid.Column="1" Padding="12,4" Click="RetroAchievementsLogoutButton_Click">
                                <TextBlock Text="Log Out" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Extra ROM folders" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="8,4" Click="AddRomPoolButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe145;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                    <TextBlock Text="Add Folder..." />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Each needs its own &lt;platform&gt; subfolder, same as C:\Games\ROMs." FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding ExtraRomPaths.Count, Converter={StaticResource CountToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding ExtraRomPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                        <Button Grid.Column="1" Width="28" Margin="8,0,0,0" Click="RemoveRomPoolButton_Click"
                                                CommandParameter="{Binding}" ToolTip="Remove">
                                            <TextBlock Text="&#xe92e;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ListBox Grid.Row="4" ItemsSource="{Binding Source={StaticResource GroupedEmulatorPlatforms}}"
                             Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                             BorderThickness="0" ScrollViewer.CanContentScroll="False">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <!-- GroupItem's own DataContext is the CollectionViewGroup it represents,
                                     so Name/ItemCount below bind against that ambiently - no RelativeSource
                                     needed. -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,0,0,4">
                                                        <ToggleButton x:Name="HeaderToggle" IsChecked="False"
                                                                      Style="{StaticResource CategoryExpanderToggleStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ItemsPresenter x:Name="GroupItems" Margin="0,4,0,0" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger SourceName="HeaderToggle" Property="IsChecked" Value="True">
                                                            <Setter TargetName="GroupItems" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RomCountText}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding EmulatorPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4" Margin="0,0,8,0"
                                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                     Background="{DynamicResource SurfaceBackgroundBrush}" />
                                            <Button Grid.Column="1" Padding="8,4" Margin="0,0,8,0" Click="DownloadEmulatorButton_Click"
                                                    CommandParameter="{Binding}" ToolTip="Download an emulator for this platform">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xf090;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Download" />
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu ItemsSource="{Binding DownloadLinks}" Placement="Bottom">
                                                        <ContextMenu.ItemTemplate>
                                                            <DataTemplate>
                                                                <MenuItem Header="{Binding Name}" Click="DownloadLinkMenuItem_Click"
                                                                          CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ContextMenu.ItemTemplate>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Grid.Column="2" Padding="8,4" Margin="0,0,8,0" Click="BrowseEmulatorPath_Click" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe2c8;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Browse..." />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Padding="8,4" Click="OpenEmulatorButton_Click" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Open this emulator on its own, to configure it">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe89e;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Launch" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsRetroArch, Converter={StaticResource BoolToVisibility}}"
                                                    Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding AvailableCores.Count, Converter={StaticResource CountToVisibility}}">
                                                <TextBlock Text="Core:" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                                <ComboBox Width="260" ItemsSource="{Binding AvailableCores}" SelectedItem="{Binding SelectedCore}"
                                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                          Background="{DynamicResource SurfaceBackgroundBrush}" />
                                                <Button Padding="6,4" Margin="8,0,0,0" Click="RefreshCoresButton_Click" CommandParameter="{Binding}"
                                                        ToolTip="Rescan the cores folder">
                                                    <TextBlock Text="&#xe5d5;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding AvailableCores.Count, Converter={StaticResource CountToVisibilityInverse}}">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                                                           Text="No cores found in a &quot;cores&quot; folder next to RetroArch." VerticalAlignment="Center" />
                                                <Button Padding="6,4" Margin="8,0,0,0" Click="RefreshCoresButton_Click" CommandParameter="{Binding}"
                                                        ToolTip="Rescan the cores folder">
                                                    <TextBlock Text="&#xe5d5;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBox Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                                                 Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}"
                                                 ToolTip="Launch arguments — {rom} is replaced with the ROM's path"
                                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                 Background="{DynamicResource SurfaceBackgroundBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
